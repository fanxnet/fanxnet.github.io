Git 精简常用命令速查表（纯文本）
一、仓库基础
git init # 本地初始化 git 仓库
git clone 仓库地址 # 克隆远程仓库到本地
git remote -v # 查看绑定的远程仓库
git remote add origin 仓库地址 # 绑定远程仓库
git remote set-url origin 新地址 # 修改远程仓库地址
二、本地提交
git status # 查看文件变更状态
git add . # 所有变更文件加入暂存区
git commit -m "提交备注" # 提交到本地仓库
git commit --amend # 修改上一次提交备注
三、拉取推送
git pull origin main # 拉取远程 main 分支最新代码
git push -u origin main # 首次推送并绑定远程分支
git push origin main # 常规推送代码
git pull origin main --allow-unrelated-histories # 合并无关联仓库代码
四、分支操作
git branch # 查看本地所有分支
git branch -M main # 将当前分支重命名为 main
git checkout -b dev # 创建并切换到 dev 分支
git checkout main # 切换到 main 分支
git merge dev # 把 dev 分支合并到当前分支
git branch -d dev # 删除本地 dev 分支
五、版本回退
git log --oneline # 简洁查看所有提交记录
git reset --hard 提交 ID # 强制回退到指定版本，丢弃本地修改
git reflog # 查看所有操作记录，找回误提交版本
六、Fork 同步上游代码
git remote add upstream 原项目地址 # 绑定上游原仓库
git fetch upstream # 拉取上游最新代码
git merge upstream/main # 合并上游 main 分支代码
git push origin main # 推送到自己远程仓库
七、全局配置
git config --global credential.helper store # 保存账号凭证，免重复输入 Token
git config --global init.defaultBranch main # 设置 git 默认分支为 main
git config --global --list # 查看所有全局配置


